{
  "name": "juegoincendio-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "start": "node dist/interfaces/http/server.js",
    "build": "tsc -p tsconfig.json",
    "i18n:extract-scenarios": "tsx scripts/extract-scenario-i18n.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/game-session-contract.test.ts tests/game-session-transition-contract.test.ts tests/game-session-inherited-state-order.test.ts tests/game-session-key-order-contract.test.ts tests/game-scene-catalog-validator.test.ts tests/vertical-beta-graph-integrity.test.ts tests/reference-game-sessions.test.ts",
    "test:m1-acceptance": "vitest run tests/game-session-contract.test.ts tests/game-session-transition-contract.test.ts tests/game-session-inherited-state-order.test.ts tests/game-session-key-order-contract.test.ts tests/vertical-beta-graph-integrity.test.ts tests/reference-game-sessions.test.ts tests/m1-final-acceptance.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
